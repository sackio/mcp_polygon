# Polygon.io API Key
# Get your API key from https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# Polygon/Massive Flat Files S3 credentials (separate from POLYGON_API_KEY)
# Same four names used by quantum-feed's ingest tooling
# (/mnt/nas/data/code/quantum-feed/.env) — endpoint and bucket have no
# safe default, so all four are required for the flatfile tools to work.
POLYGON_S3_ACCESS_KEY=your_s3_access_key_here
POLYGON_S3_SECRET_KEY=your_s3_secret_key_here
POLYGON_S3_ENDPOINT=your_s3_endpoint_here
POLYGON_S3_BUCKET=your_s3_bucket_here
